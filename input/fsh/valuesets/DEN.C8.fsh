ValueSet: DENC8DE1
Id: DEN.C8.DE1
Title: "Order Complementary Exams ValueSet (First)"
Description: "ValueSet for ordering complementary exams corresponding to DEN.C8.DE1 in WHO Dengue DAK"
* ^status = #draft
* ^experimental = true
* include DENConcepts#DEN.C8.DE2 "Complete blood count test (1)"
* include DENConcepts#DEN.C8.DE3 "Hematocrit (1)"
* include DENConcepts#DEN.C8.DE4 "Platelet count (1)"
* include DENConcepts#DEN.C8.DE5 "Dengue PCR"
* include DENConcepts#DEN.C8.DE6 "Dengue virus serology"

