ValueSet: DENC11DE1
Id: DEN.C11.DE1
Title: "Hematocrit Evaluation First ValueSet"
Description: "ValueSet for first hematocrit evaluation corresponding to DEN.C11.DE1 in WHO Dengue DAK"
* ^status = #draft
* ^experimental = true
* include DENConcepts#DEN.C11.DE2 "Hematocrit below reference range"
* include DENConcepts#DEN.C11.DE3 "Hematocrit above reference range"
* include DENConcepts#DEN.C11.DE4 "Normal hematocrit"

